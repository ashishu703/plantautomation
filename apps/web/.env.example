# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=verify-full

# Auth.js / NextAuth
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000
# Optional alias used by some Auth.js setups
NEXTAUTH_URL=http://localhost:3000

# Super admin seed (prisma/seed.ts)
SUPER_ADMIN_EMAIL=ashishu703@gmail.com
SUPER_ADMIN_PASSWORD=change-me-after-first-login

# Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Vercel Blob uploads
BLOB_READ_WRITE_TOKEN=

# Google Sheets (price sheet)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Master List
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/service-account.json
# Or inline JSON instead of a file path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

CACHE_TTL=300
GOOGLE_SHEETS_TIMEOUT_MS=15000

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
