# Auth.js (required) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/plant_pnl

# Super Admin seed / login
SUPER_ADMIN_EMAIL=ashishu703@gmail.com
SUPER_ADMIN_PASSWORD=

# Plant Manager seed / login (dashboard is plant-scoped)
PLANT_MANAGER_EMAIL=manager@cat6.local
PLANT_MANAGER_PASSWORD=

# Cron auth (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Master List
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials/service-account.json
# For Vercel: paste the full service-account JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_TIMEOUT_MS=15000
CACHE_TTL=300

# Cloudinary (purchase bill photos, max 3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AiSensy WhatsApp — stored in database (Admin → Integrations), not in .env

PORT=3000
NODE_ENV=development
